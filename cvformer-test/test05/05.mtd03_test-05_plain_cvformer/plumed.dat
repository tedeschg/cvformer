RESTART

MOLINFO STRUCTURE=npt_nh.pdb
WHOLEMOLECULES ENTITY0=1-272

phi10: TORSION ATOMS=150,152,162,164
psi10: TORSION ATOMS=152,162,164,166

metad: METAD ARG=phi10,psi10 PACE=1000 HEIGHT=1.2 SIGMA=0.30,0.30 BIASFACTOR=15 GRID_MIN=-pi,-pi GRID_MAX=pi,pi FILE=HILLS

PRINT STRIDE=100 ARG=phi10,psi10,metad.bias FILE=COLVAR
